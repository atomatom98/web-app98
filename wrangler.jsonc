{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app98",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0b06dcfc-80ba-4921-ac5b-76955853455f","database_name": "web-app98" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e6042e1b1f884390a44e1c34b20d7ed2" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
